# Twilio SMS Gateway Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Meta WhatsApp Cloud API Configuration
META_WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
META_WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# Test Recipient Number (to receive test alerts on your phone)
# Must include country code, e.g., +1234567890
TEST_RECIPIENT_PHONE=your_test_recipient_phone_number
